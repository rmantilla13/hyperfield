{
  "load": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input_still.png"
    }
  },
  "bgm": {
    "class_type": "LoadBackgroundRemovalModel",
    "inputs": {
      "bg_removal_name": "birefnet.safetensors"
    }
  },
  "matte": {
    "class_type": "RemoveBackground",
    "inputs": {
      "bg_removal_model": [
        "bgm",
        0
      ],
      "image": [
        "load",
        0
      ]
    }
  },
  "bgMask": {
    "class_type": "InvertMask",
    "inputs": {
      "mask": [
        "matte",
        0
      ]
    }
  },
  "bgSmall": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "load",
        0
      ],
      "upscale_method": "area",
      "width": 168,
      "height": 96,
      "crop": "disabled"
    }
  },
  "bgBlur": {
    "class_type": "ImageBlur",
    "inputs": {
      "image": [
        "bgSmall",
        0
      ],
      "blur_radius": 6,
      "sigma": 3
    }
  },
  "bgUp": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "bgBlur",
        0
      ],
      "upscale_method": "bilinear",
      "width": 1344,
      "height": 768,
      "crop": "disabled"
    }
  },
  "comp": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": [
        "load",
        0
      ],
      "source": [
        "bgUp",
        0
      ],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": [
        "bgMask",
        0
      ]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "comp",
        0
      ],
      "filename_prefix": "openfield/cutout"
    }
  }
}
