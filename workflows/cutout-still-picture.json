{
  "load": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input_still.png"
    }
  },
  "bgm": {
    "class_type": "LoadBackgroundRemovalModel",
    "inputs": {
      "bg_removal_name": "birefnet.safetensors"
    }
  },
  "matte": {
    "class_type": "RemoveBackground",
    "inputs": {
      "bg_removal_model": [
        "bgm",
        0
      ],
      "image": [
        "load",
        0
      ]
    }
  },
  "bgMask": {
    "class_type": "InvertMask",
    "inputs": {
      "mask": [
        "matte",
        0
      ]
    }
  },
  "bgLoad": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input_background.png"
    }
  },
  "bgFit": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "bgLoad",
        0
      ],
      "upscale_method": "lanczos",
      "width": 1344,
      "height": 768,
      "crop": "center"
    }
  },
  "comp": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": [
        "load",
        0
      ],
      "source": [
        "bgFit",
        0
      ],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": [
        "bgMask",
        0
      ]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "comp",
        0
      ],
      "filename_prefix": "openfield/cutout"
    }
  }
}
