{
  "src": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "input_video.mp4",
      "force_rate": 0,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 120,
      "skip_first_frames": 0,
      "select_every_nth": 1
    }
  },
  "fit": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "src",
        0
      ],
      "upscale_method": "lanczos",
      "width": 1280,
      "height": 704,
      "crop": "center"
    }
  },
  "sam": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sam3.1_multiplex_fp16.safetensors"
    }
  },
  "samText": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "sam",
        1
      ],
      "text": "person"
    }
  },
  "samTrack": {
    "class_type": "SAM3_VideoTrack",
    "inputs": {
      "images": [
        "fit",
        0
      ],
      "model": [
        "sam",
        0
      ],
      "conditioning": [
        "samText",
        0
      ],
      "detection_threshold": 0.4,
      "max_objects": 1,
      "detect_interval": 1
    }
  },
  "samMask": {
    "class_type": "SAM3_TrackToMask",
    "inputs": {
      "track_data": [
        "samTrack",
        0
      ],
      "object_indices": ""
    }
  },
  "bgMask": {
    "class_type": "InvertMask",
    "inputs": {
      "mask": [
        "samMask",
        0
      ]
    }
  },
  "bgSolid": {
    "class_type": "EmptyImage",
    "inputs": {
      "width": 1280,
      "height": 704,
      "batch_size": 1,
      "color": 45376
    }
  },
  "comp": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": [
        "fit",
        0
      ],
      "source": [
        "bgSolid",
        0
      ],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": [
        "bgMask",
        0
      ]
    }
  },
  "video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "comp",
        0
      ],
      "fps": 24
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "video",
        0
      ],
      "filename_prefix": "openfield/cutout",
      "format": "auto",
      "codec": "auto"
    }
  }
}
