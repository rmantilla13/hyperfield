  "ffLoad": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input_first_frame.png"
    }
  },
  "ffFit": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "ffLoad",
        0
      ],
      "upscale_method": "lanczos",
      "width": 1280,
      "height": 704,
      "crop": "center"
