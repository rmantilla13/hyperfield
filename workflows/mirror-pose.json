      ],
      "audio_latent": [
        "latA",
        0
      ]
    }
  },
  "guider": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": [
        "lora",
        0
      ],
      "positive": [
        "guide",
        0
      ],
      "negative": [
        "guide",
        1
      ],
      "cfg": 1
    }
  },
  "sampler": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler_ancestral"
    }
  },
  "sigmas": {
    "class_type": "ManualSigmas",
    "inputs": {
      "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 42
    }
  },
  "sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "noise",
        0
      ],
      "guider": [
        "guider",
        0
      ],
      "sampler": [
        "sampler",
        0
      ],
      "sigmas": [
        "sigmas",
        0
      ],
      "latent_image": [
        "av",
        0
      ]
    }
  },
  "split": {
    "class_type": "LTXVSeparateAVLatent",
    "inputs": {
      "av_latent": [
        "sample",
        0
      ]
    }
  },
  "crop": {
    "class_type": "LTXVCropGuides",
    "inputs": {
      "positive": [
        "guide",
        0
      ],
      "negative": [
        "guide",
        1
      ],
      "latent": [
        "split",
        0
      ]
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "crop",
        2
      ],
      "vae": [
        "vvae",
        0
      ]
    }
  },
  "video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "fps": 24
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "video",
        0
      ],
      "filename_prefix": "openfield/mirror",
      "format": "auto",
      "codec": "auto"
    }
