  "ff": {
    "class_type": "LTXVImgToVideoInplace",
    "inputs": {
      "vae": [
        "vvae",
        0
      ],
      "image": [
        "ffFit",
        0
      ],
      "latent": [
        "lat",
        0
      ],
      "strength": 1,
      "bypass": false
    }
  },
  "ctrl": {
    "class_type": "DWPreprocessor",
    "inputs": {
      "image": [
        "src",
        0
      ],
      "detect_hand": "enable",
      "detect_body": "enable",
      "detect_face": "enable",
      "resolution": 512,
      "bbox_detector": "yolox_l.onnx",
      "pose_estimator": "dw-ll_ucoco_384_bs5.torchscript.pt",
      "scale_stick_for_xinsr_cn": "disable"
    }
  }
}
