        0
      ],
      "text": "A knight in dented steel armor in a torch-lit stone hall, same movement and timing."
    }
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "text": "stick figure, skeleton, colored lines, wireframe, blurry, low quality, text, watermark"
    }
  },
  "cond": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "positive": [
