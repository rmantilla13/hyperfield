      "custom_width": 1280,
      "custom_height": 704,
      "frame_load_cap": 121,
      "skip_first_frames": 0,
      "select_every_nth": 1
    }
  },
  "ctrlFit": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "ctrl",
        0
      ],
      "upscale_method": "lanczos",
      "width": 1280,
      "height": 704,
      "crop": "center"
    }
  },
  "lat": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {
      "width": 1280,
      "height": 704,
      "length": 121,
      "batch_size": 1
    }
  },
  "guide": {
    "class_type": "LTXVAddGuide",
    "inputs": {
      "positive": [
        "cond",
        0
      ],
      "negative": [
        "cond",
        1
      ],
      "vae": [
        "vvae",
        0
      ],
      "latent": [
        "ff",
        0
      ],
      "image": [
        "ctrlFit",
        0
      ],
      "frame_idx": 0,
      "strength": 1,
      "iclora_parameters": [
        "icp",
        0
      ]
    }
  },
  "latA": {
    "class_type": "LTXVEmptyLatentAudio",
    "inputs": {
      "frames_number": 121,
      "frame_rate": 24,
      "batch_size": 1,
      "audio_vae": [
        "avae",
        0
      ]
    }
  },
  "av": {
    "class_type": "LTXVConcatAVLatent",
    "inputs": {
      "video_latent": [
