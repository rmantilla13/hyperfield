{
  "load": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "input_video.mp4",
      "force_rate": 24,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 73,
      "skip_first_frames": 0,
      "select_every_nth": 1
    }
  },
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "type": "ltxv",
      "device": "default"
    }
  },
  "vvae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ltx-2.5-video-vae-bf16.safetensors"
    }
  },
  "avae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ltx-2.5-audio-vae-bf16.safetensors"
    }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "text": "Wet stone, embers and fine sparks in sharp detail."
    }
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "text": "pc game, console game, video game, cartoon, childish, ugly"
    }
  },
  "cond": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "positive": [
        "pos",
        0
      ],
      "negative": [
        "neg",
        0
      ],
      "frame_rate": 24
    }
  },
  "fit": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "load",
        0
      ],
      "upscale_method": "lanczos",
      "width": 832,
      "height": 448,
      "crop": "center"
    }
  },
  "enc": {
    "class_type": "VAEEncodeTiled",
    "inputs": {
      "pixels": [
        "fit",
        0
      ],
      "vae": [
        "vvae",
        0
      ],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 4096,
      "temporal_overlap": 8
    }
  },
  "upmodel": {
    "class_type": "LatentUpscaleModelLoader",
    "inputs": {
      "model_name": "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors"
    }
  },
  "up": {
    "class_type": "LTXVLatentUpsampler",
    "inputs": {
      "samples": [
        "enc",
        0
      ],
      "upscale_model": [
        "upmodel",
        0
      ],
      "vae": [
        "vvae",
        0
      ]
    }
  },
  "latA": {
    "class_type": "LTXVEmptyLatentAudio",
    "inputs": {
      "frames_number": 73,
      "frame_rate": 24,
      "batch_size": 1,
      "audio_vae": [
        "avae",
        0
      ]
    }
  },
  "cat": {
    "class_type": "LTXVConcatAVLatent",
    "inputs": {
      "video_latent": [
        "up",
        0
      ],
      "audio_latent": [
        "latA",
        0
      ]
    }
  },
  "sig": {
    "class_type": "ManualSigmas",
    "inputs": {
      "sigmas": "0.5000, 0.4219, 0.0000"
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 42
    }
  },
  "sampler": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler_ancestral"
    }
  },
  "guide": {
    "class_type": "LTXVDualCFGGuider",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "positive": [
        "cond",
        0
      ],
      "negative": [
        "cond",
        1
      ],
      "video_cfg": 1,
      "audio_cfg": 1
    }
  },
  "refine": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "noise",
        0
      ],
      "guider": [
        "guide",
        0
      ],
      "sampler": [
        "sampler",
        0
      ],
      "sigmas": [
        "sig",
        0
      ],
      "latent_image": [
        "cat",
        0
      ]
    }
  },
  "sep": {
    "class_type": "LTXVSeparateAVLatent",
    "inputs": {
      "av_latent": [
        "refine",
        0
      ]
    }
  },
  "dv": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": [
        "sep",
        0
      ],
      "vae": [
        "vvae",
        0
      ],
      "tile_size": 768,
      "overlap": 64,
      "temporal_size": 4096,
      "temporal_overlap": 32
    }
  },
  "out": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": [
        "dv",
        0
      ],
      "audio": [
        "load",
        2
      ],
      "frame_rate": 24,
      "loop_count": 0,
      "filename_prefix": "OpenField_UP",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}
