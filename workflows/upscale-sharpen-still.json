{
  "load": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input_still.png"
    }
  },
  "um": {
    "class_type": "UpscaleModelLoader",
    "inputs": {
      "model_name": "RealESRGAN_x4plus.pth"
    }
  },
  "up": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": {
      "upscale_model": [
        "um",
        0
      ],
      "image": [
        "load",
        0
      ]
    }
  },
  "half": {
    "class_type": "ImageScaleBy",
    "inputs": {
      "image": [
        "up",
        0
      ],
      "upscale_method": "area",
      "scale_by": 0.5
    }
  },
  "out": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "half",
        0
      ],
      "filename_prefix": "OpenField_UP"
    }
  }
}
